# Copy this file to .env before running `agentengine dev up`.
#
# Set LLM_API_KEY for the client configured in the agent source.
# Change the model in the LLM builder.

# RESERVED native platform URI: execution state/checkpoints/history and memory storage.
# With dev services.mongodb.local=true (the default), the CLI injects the LOCAL
# operational MongoDB URI; it can differ from this private value. To use remote
# operational storage, the documented selector is services.mongodb.local=false.
# Do not rename this platform variable or use it to select the movie catalog.
# MOVIES_MONGODB_URI never falls back to this platform value.
MONGODB_URI=

# Separate Atlas movie identity: only find on sample_mflix.movies.
# T049 verified the original collection on 2026-10-22; it does not prove other grants.
# Constitution v4.0.0 additionally permits semantic-only reads of
# sample_mflix.embedded_movies in the same cluster, NOT yet implemented/validated.
# Verify find-only grants on the exact required collections before semantic access;
# the historical v3.0.0 broad-identity exception does not extend to this source.
# No index/role/catalog writes are authorized. Keep configuration roles separate.
# Enter the value privately in local .env; never commit it or paste it into chat/logs.
# This is an application secret, not a platform/checkpoint URI selector.
# The tool sandbox receives this exact name. Existing process environment wins over
# main's load_dotenv(override=False); a process-local pool retains its original URI
# until that worker exits. Changing the private file alone is not proof of reload.
MOVIES_MONGODB_URI=

# Credential for the LLM client in the agent source.

# Required when features.memory is true in agent.yaml; preserve its existing value.
# Semantic TOOL preparation also selects this EXISTING name, not a new key or a
# copy from memory. Delivery/segregation is still unverified (G4-B NOT RUN).
VOYAGE_API_KEY=
# Optional memory embedding API base URL (native runtime override).
# The installed memory service reads VOYAGE_URL, not ENDPOINT_URL_VOYAGE.
# If using a gateway, privately set VOYAGE_URL to its approved API base URL;
# preserve the matching key/model/dimension. Empty permits automatic routing ONLY
# for the unchanged memory path. Semantic search instead requires BOTH existing
# values nonblank before Client(api_key=..., base_url=...) construction; no default
# destination/fallback. No actual semantic client/binding is implemented here.
# T018 declares these EXISTING names only in sandboxes.tool.secrets. This does
# not prove native delivery, binding or egress (G4-B NOT RUN). No private value
# changes or manual service operations are required by this example.
# SDK base_url reference: https://www.mongodb.com/docs/voyageai/api-and-clients/
VOYAGE_URL=
LLM_API_KEY=
